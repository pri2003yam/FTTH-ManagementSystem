<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PlanChange"
                  targetNamespace="http://aaha-telecom.com/ftth/eoc"
                  exporter="Kiro" exporterVersion="1.0">

  <!-- Error Definitions -->
  <bpmn:error id="Error_CartCreationFailed" name="Cart Creation Failed" errorCode="ERR_CART_CREATION_FAILED" />
  <bpmn:error id="Error_CartValidationFailed" name="Cart Validation Failed" errorCode="ERR_CART_VALIDATION_FAILED" />
  <bpmn:error id="Error_CartPricingFailed" name="Cart Pricing Failed" errorCode="ERR_CART_PRICING_FAILED" />
  <bpmn:error id="Error_CartSubmissionFailed" name="Cart Submission Failed" errorCode="ERR_CART_SUBMISSION_FAILED" />
  <bpmn:error id="Error_ProductUpdateFailed" name="Product Update Failed" errorCode="ERR_PRODUCT_UPDATE_FAILED" />

  <bpmn:process id="EOC_FTTH_Plan_Change" name="EOC FTTH Plan Change" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PlanChange" name="Plan Change Requested">
      <bpmn:outgoing>Flow_Start_CreateCart</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Task: Create Plan Change Cart -->
    <bpmn:serviceTask id="Task_CreatePlanChangeCart" name="Create Plan Change Cart" camunda:delegateExpression="${createPlanChangeCartDelegate}">
      <bpmn:incoming>Flow_Start_CreateCart</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateCart_Validate</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary Error Event on Create Cart -->
    <bpmn:boundaryEvent id="BoundaryEvent_CartCreation" name="Cart Creation Error" attachedToRef="Task_CreatePlanChangeCart">
      <bpmn:outgoing>Flow_CartCreationError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_CartCreation" errorRef="Error_CartCreationFailed" />
    </bpmn:boundaryEvent>

    <!-- Service Task: Validate Cart -->
    <bpmn:serviceTask id="Task_ValidateCart" name="Validate Cart" camunda:delegateExpression="${validateCartDelegate}">
      <bpmn:incoming>Flow_CreateCart_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary Error Event on Validate Cart -->
    <bpmn:boundaryEvent id="BoundaryEvent_CartValidation" name="Cart Validation Error" attachedToRef="Task_ValidateCart">
      <bpmn:outgoing>Flow_CartValidationError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_CartValidation" errorRef="Error_CartValidationFailed" />
    </bpmn:boundaryEvent>

    <!-- Exclusive Gateway: Cart Valid? -->
    <bpmn:exclusiveGateway id="Gateway_CartValid" name="Cart Valid?">
      <bpmn:incoming>Flow_Validate_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CartValid_Price</bpmn:outgoing>
      <bpmn:outgoing>Flow_CartInvalid_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Service Task: Price Cart -->
    <bpmn:serviceTask id="Task_PriceCart" name="Price Cart" camunda:delegateExpression="${priceCartDelegate}">
      <bpmn:incoming>Flow_CartValid_Price</bpmn:incoming>
      <bpmn:outgoing>Flow_Price_Submit</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary Error Event on Price Cart -->
    <bpmn:boundaryEvent id="BoundaryEvent_CartPricing" name="Cart Pricing Error" attachedToRef="Task_PriceCart">
      <bpmn:outgoing>Flow_CartPricingError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_CartPricing" errorRef="Error_CartPricingFailed" />
    </bpmn:boundaryEvent>

    <!-- Service Task: Submit Cart -->
    <bpmn:serviceTask id="Task_SubmitCart" name="Submit Cart" camunda:delegateExpression="${submitCartDelegate}">
      <bpmn:incoming>Flow_Price_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_UpdateProduct</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary Error Event on Submit Cart -->
    <bpmn:boundaryEvent id="BoundaryEvent_CartSubmission" name="Cart Submission Error" attachedToRef="Task_SubmitCart">
      <bpmn:outgoing>Flow_CartSubmissionError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_CartSubmission" errorRef="Error_CartSubmissionFailed" />
    </bpmn:boundaryEvent>

    <!-- Service Task: Update Product for Plan Change -->
    <bpmn:serviceTask id="Task_UpdateProductForPlanChange" name="Update Product for Plan Change" camunda:delegateExpression="${updateProductForPlanChangeDelegate}">
      <bpmn:incoming>Flow_Submit_UpdateProduct</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateProduct_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Boundary Error Event on Update Product -->
    <bpmn:boundaryEvent id="BoundaryEvent_ProductUpdate" name="Product Update Error" attachedToRef="Task_UpdateProductForPlanChange">
      <bpmn:outgoing>Flow_ProductUpdateError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_ProductUpdate" errorRef="Error_ProductUpdateFailed" />
    </bpmn:boundaryEvent>

    <!-- End Event: Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Plan Change Completed">
      <bpmn:incoming>Flow_UpdateProduct_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Error End Event: Cart Validation Invalid -->
    <bpmn:endEvent id="EndEvent_ValidationFailed" name="Cart Validation Invalid">
      <bpmn:incoming>Flow_CartInvalid_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_ValidationEnd" errorRef="Error_CartValidationFailed" />
    </bpmn:endEvent>

    <!-- Error End Event: Cart Creation Failed -->
    <bpmn:endEvent id="EndEvent_CartCreationFailed" name="Cart Creation Failed">
      <bpmn:incoming>Flow_CartCreationError_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_CartCreationEnd" errorRef="Error_CartCreationFailed" />
    </bpmn:endEvent>

    <!-- Error End Event: Cart Validation Exception -->
    <bpmn:endEvent id="EndEvent_CartValidationFailed" name="Cart Validation Exception">
      <bpmn:incoming>Flow_CartValidationError_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_CartValidationEnd" errorRef="Error_CartValidationFailed" />
    </bpmn:endEvent>

    <!-- Error End Event: Cart Pricing Failed -->
    <bpmn:endEvent id="EndEvent_CartPricingFailed" name="Cart Pricing Failed">
      <bpmn:incoming>Flow_CartPricingError_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_CartPricingEnd" errorRef="Error_CartPricingFailed" />
    </bpmn:endEvent>

    <!-- Error End Event: Cart Submission Failed -->
    <bpmn:endEvent id="EndEvent_CartSubmissionFailed" name="Cart Submission Failed">
      <bpmn:incoming>Flow_CartSubmissionError_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_CartSubmissionEnd" errorRef="Error_CartSubmissionFailed" />
    </bpmn:endEvent>

    <!-- Error End Event: Product Update Failed -->
    <bpmn:endEvent id="EndEvent_ProductUpdateFailed" name="Product Update Failed">
      <bpmn:incoming>Flow_ProductUpdateError_End</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_ProductUpdateEnd" errorRef="Error_ProductUpdateFailed" />
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_CreateCart" sourceRef="StartEvent_PlanChange" targetRef="Task_CreatePlanChangeCart" />
    <bpmn:sequenceFlow id="Flow_CreateCart_Validate" sourceRef="Task_CreatePlanChangeCart" targetRef="Task_ValidateCart" />
    <bpmn:sequenceFlow id="Flow_Validate_Gateway" sourceRef="Task_ValidateCart" targetRef="Gateway_CartValid" />
    <bpmn:sequenceFlow id="Flow_CartValid_Price" name="Valid" sourceRef="Gateway_CartValid" targetRef="Task_PriceCart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cartValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CartInvalid_End" name="Invalid" sourceRef="Gateway_CartValid" targetRef="EndEvent_ValidationFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cartValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Price_Submit" sourceRef="Task_PriceCart" targetRef="Task_SubmitCart" />
    <bpmn:sequenceFlow id="Flow_Submit_UpdateProduct" sourceRef="Task_SubmitCart" targetRef="Task_UpdateProductForPlanChange" />
    <bpmn:sequenceFlow id="Flow_UpdateProduct_End" sourceRef="Task_UpdateProductForPlanChange" targetRef="EndEvent_Success" />

    <!-- Error Boundary Flows -->
    <bpmn:sequenceFlow id="Flow_CartCreationError_End" sourceRef="BoundaryEvent_CartCreation" targetRef="EndEvent_CartCreationFailed" />
    <bpmn:sequenceFlow id="Flow_CartValidationError_End" sourceRef="BoundaryEvent_CartValidation" targetRef="EndEvent_CartValidationFailed" />
    <bpmn:sequenceFlow id="Flow_CartPricingError_End" sourceRef="BoundaryEvent_CartPricing" targetRef="EndEvent_CartPricingFailed" />
    <bpmn:sequenceFlow id="Flow_CartSubmissionError_End" sourceRef="BoundaryEvent_CartSubmission" targetRef="EndEvent_CartSubmissionFailed" />
    <bpmn:sequenceFlow id="Flow_ProductUpdateError_End" sourceRef="BoundaryEvent_ProductUpdate" targetRef="EndEvent_ProductUpdateFailed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_PlanChange">
    <bpmndi:BPMNPlane id="BPMNPlane_PlanChange" bpmnElement="EOC_FTTH_Plan_Change">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_PlanChange_di" bpmnElement="StartEvent_PlanChange">
        <dc:Bounds x="180" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156" y="243" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Create Plan Change Cart -->
      <bpmndi:BPMNShape id="Task_CreatePlanChangeCart_di" bpmnElement="Task_CreatePlanChangeCart">
        <dc:Bounds x="270" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary Event: Cart Creation -->
      <bpmndi:BPMNShape id="BoundaryEvent_CartCreation_di" bpmnElement="BoundaryEvent_CartCreation">
        <dc:Bounds x="302" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Validate Cart -->
      <bpmndi:BPMNShape id="Task_ValidateCart_di" bpmnElement="Task_ValidateCart">
        <dc:Bounds x="430" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary Event: Cart Validation -->
      <bpmndi:BPMNShape id="BoundaryEvent_CartValidation_di" bpmnElement="BoundaryEvent_CartValidation">
        <dc:Bounds x="462" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Cart Valid? -->
      <bpmndi:BPMNShape id="Gateway_CartValid_di" bpmnElement="Gateway_CartValid" isMarkerVisible="true">
        <dc:Bounds x="590" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="587" y="163" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Price Cart -->
      <bpmndi:BPMNShape id="Task_PriceCart_di" bpmnElement="Task_PriceCart">
        <dc:Bounds x="700" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary Event: Cart Pricing -->
      <bpmndi:BPMNShape id="BoundaryEvent_CartPricing_di" bpmnElement="BoundaryEvent_CartPricing">
        <dc:Bounds x="732" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Submit Cart -->
      <bpmndi:BPMNShape id="Task_SubmitCart_di" bpmnElement="Task_SubmitCart">
        <dc:Bounds x="860" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary Event: Cart Submission -->
      <bpmndi:BPMNShape id="BoundaryEvent_CartSubmission_di" bpmnElement="BoundaryEvent_CartSubmission">
        <dc:Bounds x="892" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Update Product for Plan Change -->
      <bpmndi:BPMNShape id="Task_UpdateProductForPlanChange_di" bpmnElement="Task_UpdateProductForPlanChange">
        <dc:Bounds x="1020" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <!-- Boundary Event: Product Update -->
      <bpmndi:BPMNShape id="BoundaryEvent_ProductUpdate_di" bpmnElement="BoundaryEvent_ProductUpdate">
        <dc:Bounds x="1052" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- End Event: Success -->
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="1180" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1156" y="243" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Validation Invalid -->
      <bpmndi:BPMNShape id="EndEvent_ValidationFailed_di" bpmnElement="EndEvent_ValidationFailed">
        <dc:Bounds x="597" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="573" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Cart Creation Failed -->
      <bpmndi:BPMNShape id="EndEvent_CartCreationFailed_di" bpmnElement="EndEvent_CartCreationFailed">
        <dc:Bounds x="302" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="278" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Cart Validation Exception -->
      <bpmndi:BPMNShape id="EndEvent_CartValidationFailed_di" bpmnElement="EndEvent_CartValidationFailed">
        <dc:Bounds x="462" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="438" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Cart Pricing Failed -->
      <bpmndi:BPMNShape id="EndEvent_CartPricingFailed_di" bpmnElement="EndEvent_CartPricingFailed">
        <dc:Bounds x="732" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="708" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Cart Submission Failed -->
      <bpmndi:BPMNShape id="EndEvent_CartSubmissionFailed_di" bpmnElement="EndEvent_CartSubmissionFailed">
        <dc:Bounds x="892" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="868" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error End Event: Product Update Failed -->
      <bpmndi:BPMNShape id="EndEvent_ProductUpdateFailed_di" bpmnElement="EndEvent_ProductUpdateFailed">
        <dc:Bounds x="1052" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1028" y="393" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_Start_CreateCart_di" bpmnElement="Flow_Start_CreateCart">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="270" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CreateCart_Validate_di" bpmnElement="Flow_CreateCart_Validate">
        <di:waypoint x="370" y="218" />
        <di:waypoint x="430" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Validate_Gateway_di" bpmnElement="Flow_Validate_Gateway">
        <di:waypoint x="530" y="218" />
        <di:waypoint x="590" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CartValid_Price_di" bpmnElement="Flow_CartValid_Price">
        <di:waypoint x="640" y="218" />
        <di:waypoint x="700" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="658" y="200" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CartInvalid_End_di" bpmnElement="Flow_CartInvalid_End">
        <di:waypoint x="615" y="243" />
        <di:waypoint x="615" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="290" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Price_Submit_di" bpmnElement="Flow_Price_Submit">
        <di:waypoint x="800" y="218" />
        <di:waypoint x="860" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Submit_UpdateProduct_di" bpmnElement="Flow_Submit_UpdateProduct">
        <di:waypoint x="960" y="218" />
        <di:waypoint x="1020" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_UpdateProduct_End_di" bpmnElement="Flow_UpdateProduct_End">
        <di:waypoint x="1120" y="218" />
        <di:waypoint x="1180" y="218" />
      </bpmndi:BPMNEdge>

      <!-- Error Boundary Flow Edges -->
      <bpmndi:BPMNEdge id="Flow_CartCreationError_End_di" bpmnElement="Flow_CartCreationError_End">
        <di:waypoint x="320" y="276" />
        <di:waypoint x="320" y="350" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CartValidationError_End_di" bpmnElement="Flow_CartValidationError_End">
        <di:waypoint x="480" y="276" />
        <di:waypoint x="480" y="350" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CartPricingError_End_di" bpmnElement="Flow_CartPricingError_End">
        <di:waypoint x="750" y="276" />
        <di:waypoint x="750" y="350" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_CartSubmissionError_End_di" bpmnElement="Flow_CartSubmissionError_End">
        <di:waypoint x="910" y="276" />
        <di:waypoint x="910" y="350" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ProductUpdateError_End_di" bpmnElement="Flow_ProductUpdateError_End">
        <di:waypoint x="1070" y="276" />
        <di:waypoint x="1070" y="350" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
