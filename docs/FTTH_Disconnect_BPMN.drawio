        <mxCell id="e2" value="YES" style="edgeStyle=orthogonalEdgeStyle;fontStyle=1;fontSize=10;" edge="1" source="gw1" target="t_disconnect" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2_err" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;fontSize=10;" edge="1" source="gw1" target="err1" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
