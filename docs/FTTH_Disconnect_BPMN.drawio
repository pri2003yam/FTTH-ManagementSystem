        <mxCell id="t_mail" value="&quot;Connection Disconnected&#xa;- Aaha Telecom&quot;&#xa;Connection ID" style="shape=mxgraph.bpmn.task;taskMarker=send;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="lane_email">
