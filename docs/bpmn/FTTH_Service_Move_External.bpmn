<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_MV"
                  targetNamespace="http://aaha-telecom.com/ftth">

  <bpmn:process id="Process_ServiceMove" name="Service Move" isExecutable="true">

    <bpmn:startEvent id="Start" name="Move request">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Check new service area exists -->
    <bpmn:serviceTask id="Task_CheckArea" name="Check New Service Area"
                      camunda:type="external" camunda:topic="mv_checkArea">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_Area" name="Area Available?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_Area_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_Area_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check same OLT type ports in new area -->
    <bpmn:serviceTask id="Task_CheckPorts" name="Check OLT Type Ports in New Area"
                      camunda:type="external" camunda:topic="mv_checkPorts">
      <bpmn:incoming>F_Area_Yes</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_Ports" name="Ports Available?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Ports_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_Ports_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Execute move -->
    <bpmn:serviceTask id="Task_Move" name="Move Connection (Allocate + Release + Update + Email)"
                      camunda:type="external" camunda:topic="mv_moveConnection">
      <bpmn:incoming>F_Ports_Yes</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Success" name="Customer Moved">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Err_Area" name="Area Not Available">
      <bpmn:incoming>F_Area_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Err_Ports" name="No Matching OLT Ports">
      <bpmn:incoming>F_Ports_No</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_CheckArea" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckArea" targetRef="GW_Area" />
    <bpmn:sequenceFlow id="F_Area_Yes" name="YES" sourceRef="GW_Area" targetRef="Task_CheckPorts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${areaActive == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Area_No" name="NO" sourceRef="GW_Area" targetRef="End_Err_Area">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${areaActive == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CheckPorts" targetRef="GW_Ports" />
    <bpmn:sequenceFlow id="F_Ports_Yes" name="YES" sourceRef="GW_Ports" targetRef="Task_Move">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${availablePorts &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Ports_No" name="NO" sourceRef="GW_Ports" targetRef="End_Err_Ports">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${availablePorts &lt;= 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Move" targetRef="End_Success" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MV">
    <bpmndi:BPMNPlane id="BPMNPlane_MV" bpmnElement="Process_ServiceMove">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="180" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckArea_di" bpmnElement="Task_CheckArea"><dc:Bounds x="270" y="140" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Area_di" bpmnElement="GW_Area" isMarkerVisible="true"><dc:Bounds x="485" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPorts_di" bpmnElement="Task_CheckPorts"><dc:Bounds x="590" y="140" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Ports_di" bpmnElement="GW_Ports" isMarkerVisible="true"><dc:Bounds x="825" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Move_di" bpmnElement="Task_Move"><dc:Bounds x="930" y="140" width="200" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_di" bpmnElement="End_Success"><dc:Bounds x="1192" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Err_Area_di" bpmnElement="End_Err_Area"><dc:Bounds x="492" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Err_Ports_di" bpmnElement="End_Err_Ports"><dc:Bounds x="832" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="216" y="180" /><di:waypoint x="270" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="430" y="180" /><di:waypoint x="485" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Area_Yes_di" bpmnElement="F_Area_Yes"><di:waypoint x="535" y="180" /><di:waypoint x="590" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Area_No_di" bpmnElement="F_Area_No"><di:waypoint x="510" y="205" /><di:waypoint x="510" y="302" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="770" y="180" /><di:waypoint x="825" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ports_Yes_di" bpmnElement="F_Ports_Yes"><di:waypoint x="875" y="180" /><di:waypoint x="930" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ports_No_di" bpmnElement="F_Ports_No"><di:waypoint x="850" y="205" /><di:waypoint x="850" y="302" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="1130" y="180" /><di:waypoint x="1192" y="180" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>