<mxfile host="app.diagrams.net" modified="2024-06-12T00:00:00.000Z" agent="Kiro" version="22.1.2">
  <diagram name="Plan Change — Aaha Telecom" id="ftth-plan-change">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- POOL -->
        <mxCell id="pool" value="Plan Change — POST /api/connections/{id}/change-plan" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=0;resizeParent=1;collapsible=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="2100" height="1100" as="geometry" />
        </mxCell>

        <!-- LANE: CSR -->
        <mxCell id="lane_csr" value="CSR" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pool">
          <mxGeometry x="0" y="30" width="2100" height="180" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="shape=mxgraph.bpmn.shape;perimeter=mxPerimeter.ellipsePerimeter;symbol=general;outline=standard;fillColor=#67AB9F;strokeColor=#2D7600;" vertex="1" parent="lane_csr">
          <mxGeometry x="60" y="70" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="Select Connection&#xa;&amp; New Plan&#xa;(connectionId, newPlanId)" style="shape=mxgraph.bpmn.task;taskMarker=user;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_csr">
          <mxGeometry x="150" y="50" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t_done" value="Plan Changed&#xa;Successfully ✓" style="shape=mxgraph.bpmn.task;taskMarker=user;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="lane_csr">
          <mxGeometry x="1870" y="55" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="start" target="t1" parent="lane_csr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE: SYSTEM -->
        <mxCell id="lane_sys" value="SYSTEM" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pool">
          <mxGeometry x="0" y="210" width="2100" height="450" as="geometry" />
        </mxCell>

        <!-- Step 1: Validate new plan -->
