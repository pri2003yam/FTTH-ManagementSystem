        <mxCell id="gw1_l" value="Connection&#xa;Active?" style="text;html=1;align=center;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="lane_sys">
          <mxGeometry x="358" y="45" width="95" height="33" as="geometry" />
        </mxCell>

        <!-- Step 3: Check OLT type change -->
        <mxCell id="gw2" value="X" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="lane_sys">
