          <mxGeometry x="600" y="170" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 4: Update plan -->
        <mxCell id="t_update" value="Update Connection&#xa;Plan ID&#xa;connectionRepo&#xa;.updatePlan()" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lane_sys">
