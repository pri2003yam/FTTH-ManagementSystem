<mxfile host="app.diagrams.net" modified="2024-06-12T00:00:00.000Z" agent="Kiro" version="22.1.2">
  <diagram name="Service Move — Aaha Telecom" id="ftth-service-move">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- POOL -->
        <mxCell id="pool" value="Service Move — POST /api/connections/{id}/move" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=0;resizeParent=1;collapsible=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="2300" height="1100" as="geometry" />
        </mxCell>

        <!-- LANE: CSR -->
        <mxCell id="lane_csr" value="CSR" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pool">
          <mxGeometry x="0" y="30" width="2300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="shape=mxgraph.bpmn.shape;perimeter=mxPerimeter.ellipsePerimeter;symbol=general;outline=standard;fillColor=#67AB9F;strokeColor=#2D7600;" vertex="1" parent="lane_csr">
          <mxGeometry x="60" y="80" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="Select Active&#xa;Connection &amp;&#xa;Enter New Pincode" style="shape=mxgraph.bpmn.task;taskMarker=user;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_csr">
          <mxGeometry x="150" y="55" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="t_done" value="Customer Moved&#xa;Successfully ✓" style="shape=mxgraph.bpmn.task;taskMarker=user;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="lane_csr">
          <mxGeometry x="2060" y="60" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="start" target="t1" parent="lane_csr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE: SYSTEM -->
        <mxCell id="lane_sys" value="SYSTEM" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pool">
          <mxGeometry x="0" y="230" width="2300" height="450" as="geometry" />
        </mxCell>

        <!-- Step 1: Get current plan's OLT type -->
        <mxCell id="t_get_plan" value="Get Current Plan&#xa;oltType from&#xa;planService&#xa;.findPlanById(&#xa;conn.getPlanId())" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="150" y="65" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Step 2: Validate new service area -->
        <mxCell id="t_validate" value="Find New&#xa;Service Area&#xa;serviceAreaService&#xa;.getActiveServiceArea&#xa;(newPincode)" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="380" y="65" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- GW1: Area valid & active? -->
        <mxCell id="gw1" value="X" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="610" y="85" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw1_l" value="New Area&#xa;Exists &amp;&#xa;Active?" style="text;html=1;align=center;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="lane_sys">
          <mxGeometry x="590" y="42" width="90" height="40" as="geometry" />
        </mxCell>

        <!-- Step 3: Check OLT type port availability -->
        <mxCell id="t_check_ports" value="Check Port Availability&#xa;for SAME oltType&#xa;in New Pincode&#xa;inventoryService&#xa;.getAvailablePortsByType&#xa;(newAreaId, oltType)" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="720" y="55" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- GW2: Matching OLT type ports available? -->
        <mxCell id="gw2" value="X" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="975" y="85" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw2_l" value="Same OLT Type&#xa;Ports Available&#xa;in New Pin?" style="text;html=1;align=center;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="lane_sys">
          <mxGeometry x="948" y="35" width="105" height="48" as="geometry" />
        </mxCell>

        <!-- Step 4: Allocate new port -->
        <mxCell id="t_alloc" value="Allocate New Port&#xa;in New Area&#xa;inventoryService&#xa;.allocatePort(&#xa;newAreaId, oltType)" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="1090" y="60" width="170" height="100" as="geometry" />
        </mxCell>

        <!-- Step 5: Release old port -->
        <mxCell id="t_release" value="Release Old Port&#xa;(ASSIGNED →&#xa;AVAILABLE)&#xa;inventoryService&#xa;.releasePort()" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="1320" y="60" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Step 6: Update connection record -->
        <mxCell id="t_update" value="Update Connection&#xa;(serviceAreaId,&#xa;portId, updatedBy)&#xa;connectionRepo&#xa;.updateLocation()" style="shape=mxgraph.bpmn.task;taskMarker=service;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="1540" y="60" width="170" height="100" as="geometry" />
        </mxCell>

        <!-- Step 7: Send email -->
        <mxCell id="t_email" value="Send SERVICE_MOVE&#xa;Email&#xa;email&#xa;.sendCustomerMoveEmail&#xa;(customer, conn,&#xa;newPincode)" style="shape=mxgraph.bpmn.task;taskMarker=send;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lane_sys">
          <mxGeometry x="1770" y="55" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end_ok" value="" style="shape=mxgraph.bpmn.shape;perimeter=mxPerimeter.ellipsePerimeter;symbol=terminate;outline=end;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_sys">
          <mxGeometry x="2020" y="90" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Error 1: Area not found -->
        <mxCell id="err1" value="" style="shape=mxgraph.bpmn.shape;perimeter=mxPerimeter.ellipsePerimeter;symbol=terminate;outline=end;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_sys">
          <mxGeometry x="615" y="330" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="err1_l" value="Service not&#xa;available in&#xa;this pincode" style="text;html=1;align=center;fontSize=9;fillColor=none;strokeColor=none;" vertex="1" parent="lane_sys">
          <mxGeometry x="590" y="372" width="90" height="35" as="geometry" />
        </mxCell>

        <!-- Error 2: No matching OLT type ports -->
        <mxCell id="err2" value="" style="shape=mxgraph.bpmn.shape;perimeter=mxPerimeter.ellipsePerimeter;symbol=terminate;outline=end;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_sys">
          <mxGeometry x="980" y="330" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="err2_l" value="No [oltType] ports&#xa;available in new&#xa;pincode" style="text;html=1;align=center;fontSize=9;fillColor=none;strokeColor=none;" vertex="1" parent="lane_sys">
          <mxGeometry x="950" y="372" width="100" height="35" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_get_plan" target="t_validate" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_validate" target="gw1" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="YES" style="edgeStyle=orthogonalEdgeStyle;fontStyle=1;fontSize=10;" edge="1" source="gw1" target="t_check_ports" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_err" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;fontSize=10;" edge="1" source="gw1" target="err1" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_check_ports" target="gw2" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="YES" style="edgeStyle=orthogonalEdgeStyle;fontStyle=1;fontSize=10;" edge="1" source="gw2" target="t_alloc" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5_err" value="NO" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;fontSize=10;" edge="1" source="gw2" target="err2" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_alloc" target="t_release" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_release" target="t_update" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_update" target="t_email" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="t_email" target="end_ok" parent="lane_sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LANE: DATABASE -->
        <mxCell id="lane_db" value="DATABASE" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="pool">
          <mxGeometry x="0" y="680" width="2300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="db1" value="plans&#xa;(olt_type)" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="lane_db">
          <mxGeometry x="195" y="55" width="80" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db2" value="service_areas" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="lane_db">
          <mxGeometry x="420" y="55" width="90" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db3" value="ports&#xa;(by olt_type)" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="lane_db">
          <mxGeometry x="770" y="55" width="90" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db4" value="customer_&#xa;connections" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane_db">
          <mxGeometry x="1580" y="55" width="90" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db5" value="email_logs" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane_db">
          <mxGeometry x="1820" y="55" width="90" height="55" as="geometry" />
        </mxCell>

        <!-- LANE: EMAIL -->
        <mxCell id="lane_email" value="EMAIL SERVICE" style="swimlane;startSize=30;horizontal=0;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="pool">
          <mxGeometry x="0" y="850" width="2300" height="140" as="geometry" />
        </mxCell>

        <mxCell id="t_mail" value="&quot;Service Area Updated&#xa;- Aaha Telecom&quot;&#xa;New Pincode: [pincode]" style="shape=mxgraph.bpmn.task;taskMarker=send;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="lane_email">
          <mxGeometry x="1770" y="30" width="190" height="75" as="geometry" />
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="leg" value="Key Rule: Customer's plan has an OLT type (OLT300/OLT500). Move only allowed if new pincode has available ports of the SAME OLT type." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;fontStyle=3;" vertex="1" parent="pool">
          <mxGeometry x="50" y="1010" width="750" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="State Changes:  Old Port: ASSIGNED → AVAILABLE    New Port: AVAILABLE → ASSIGNED    Connection: serviceAreaId + portId updated" style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;fontStyle=2;" vertex="1" parent="pool">
          <mxGeometry x="50" y="1040" width="700" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
